{
  "env": {
    "CLAUDE_ENV": "dev",
    "SKX_LOG_DIR": "~/.claude/logs",
    "SKX_POLICIES_DIR": "~/.claude/skx-infra-guard/policies",
    "PROTECTED_BRANCHES": "main:master:release:hotfix:production",
    "ASSUME_PROD_WHEN_UNKNOWN": "true",
    "PRODUCTION_NAMESPACES": "prod:production:prd"
  },
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(terraform plan*)",
      "Bash(terraform validate)",
      "Bash(terraform fmt*)",
      "Bash(ls*)",
      "Bash(find*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(pwd)",
      "Bash(whoami)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(:(){ :|:& };:)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(terraform destroy*)",
      "Bash(kubectl delete *)",
      "Bash(git push --force *)",
      "Bash(git push * -f)",
      "Bash(git reset --hard *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/pre-tool-use.sh", "timeout": 15 }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/pre-tool-use.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "WebFetch",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/pre-tool-use.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/pre-tool-use.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash ~/.claude/hooks/post-tool-use.sh", "timeout": 15 }
        ]
      }
    ]
  }
}
